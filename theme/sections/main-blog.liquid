{%- comment -%}
  Danh sách bài viết của blog: breadcrumb, chip lọc theo tag và lưới thẻ bài viết có phân trang.
{%- endcomment -%}
<nav class="container crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Trang chủ</a> › <span>{{ blog.title }}</span></nav>
<section class="container">
  <h1 class="page-title">{{ blog.title }}</h1>
  {%- if blog.all_tags.size > 0 -%}
    <div class="tabs">
      <a class="tab{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">Tất cả</a>
      {%- for tag in blog.all_tags -%}
        <a class="tab{% if current_tags contains tag %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- paginate blog.articles by section.settings.per_page -%}
    {%- if blog.articles.size > 0 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <article class="post-card">
            <a class="post-card__media" href="{{ article.url }}">
              {%- if article.image -%}{{ article.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{% render 'placeholder' %}{%- endif -%}
            </a>
            <div class="post-card__body">
              <time class="post-card__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%d/%m/%Y' }}</time>
              <h2 class="post-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
              <a class="post-card__more" href="{{ article.url }}">Đọc tiếp ›</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<div class="center pager">{{ paginate | default_pagination: next: 'Sau ›', previous: '‹ Trước' }}</div>{%- endif -%}
    {%- else -%}
      <p class="center">Chưa có bài viết nào.</p>
    {%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}
{
  "name": "Danh sách bài viết",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Số bài mỗi trang", "min": 3, "max": 24, "step": 3, "default": 9 }
  ]
}
{% endschema %}
