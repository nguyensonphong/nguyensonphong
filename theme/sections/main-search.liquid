<section class="container">
  <h1 class="page-title">{% if search.performed %}Kết quả cho "{{ search.terms }}" ({{ search.results_count }}){% else %}Tìm kiếm{% endif %}</h1>
  {%- paginate search.results by 24 -%}
    <div class="grid-products">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}{% render 'product-card', product: item %}
        {%- else -%}<a class="cat" href="{{ item.url }}">{{ item.title }}</a>{%- endif -%}
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="center">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Kết quả tìm kiếm" }{% endschema %}
