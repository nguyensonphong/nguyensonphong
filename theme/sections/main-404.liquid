<section class="container cart-empty nf">
  <b class="nf__code">404</b>
  <h1 class="page-title">Không tìm thấy trang bạn cần</h1>
  <p>Trang có thể đã đổi địa chỉ. Bạn thử tìm sản phẩm hoặc quay lại trang chủ.</p>
  <form class="search search--page" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" placeholder="Tìm sản phẩm" aria-label="Tìm kiếm"><input type="hidden" name="type" value="product">
    <button type="submit" aria-label="Tìm kiếm">{% render 'icon', name: 'search' %}</button>
  </form>
  <a class="btn btn--lg" href="{{ routes.root_url }}">Về trang chủ</a>
</section>
{% schema %}{ "name": "404" }{% endschema %}
