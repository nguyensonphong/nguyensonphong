{%- comment -%}
  Thẻ sản phẩm. Truyền vào: product (bắt buộc khi có dữ liệu thật), style: 'flash' | 'shock' | 'new' | 'popular'.
  Khi chưa có product (theme mới cài), hiển thị thẻ mẫu.
{%- endcomment -%}
{%- if product -%}
  {%- assign v = product.selected_or_first_available_variant -%}
  {%- assign off = 0 -%}
  {%- if product.compare_at_price > product.price -%}
    {%- assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price | round -%}
  {%- endif -%}
  <article class="pcard">
    <a class="pcard__img" href="{{ product.url }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: product.title }}
      {%- else -%}{% render 'icon', name: 'box' %}{%- endif -%}
    </a>
    {%- if style == 'new' -%}<span class="pcard__tag pcard__tag--new">NEW</span>
    {%- elsif product.tags contains 'best-price' -%}<span class="pcard__tag">Best Price</span>
    {%- elsif off > 0 -%}<span class="pcard__tag">-{{ off }}%</span>{%- endif -%}
    <button class="pcard__fav" type="button" aria-label="Yêu thích" data-fav>{% render 'icon', name: 'heart' %}</button>
    {%- assign brand_col = collections[product.vendor | handleize] -%}
    {%- if brand_col and brand_col.template_suffix == 'brand' -%}<a class="pcard__vendor" href="{{ brand_col.url }}">{{ product.vendor }}</a>{%- else -%}<span class="pcard__vendor">{{ product.vendor }}</span>{%- endif -%}
    <a href="{{ product.url }}"><h3 class="pcard__title">{{ product.title }}</h3></a>
    <div class="pcard__chips">
      {%- if product.tags contains 'free-install' -%}<span class="chip">Lắp đặt miễn phí</span>{%- endif -%}
      {%- if product.tags contains 'free-shipping' or product.price >= 50000000 -%}<span class="chip">Miễn phí giao hàng</span>{%- endif -%}
    </div>
    <div class="pcard__price">
      <div class="price">
        <span>{{ product.price | money_without_trailing_zeros }}{%- if style == 'flash' -%}<i class="pcard__bolt">⚡</i>{%- endif -%}</span>
        {%- if off > 0 -%}<s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
      </div>
      <form method="post" action="{{ routes.cart_add_url }}" data-add-form>
        <input type="hidden" name="id" value="{{ v.id }}">
        <button class="addcart" type="submit" aria-label="Thêm vào giỏ" {% unless v.available %}disabled{% endunless %}>{% render 'icon', name: 'cart' %}</button>
      </form>
    </div>
    {%- if product.metafields.custom.final_price != blank -%}<div class="pcard__final">Giá cuối* {{ product.metafields.custom.final_price | money_without_trailing_zeros }}</div>{%- endif -%}
    <div class="pcard__extra">
      {%- if product.price >= 300000000 -%}Trả góp 0%{%- endif -%}
      {%- if product.metafields.custom.extra_offer != blank -%}{% if product.price >= 300000000 %}, {% endif %}{{ product.metafields.custom.extra_offer }}{%- endif -%}
    </div>
    <div class="pcard__foot">
      <span class="pcard__ship" title="Giao tận nhà · Nhận tại cửa hàng · Giao tiêu chuẩn">{% render 'icon', name: 'truck' %}{% render 'icon', name: 'store' %}{% render 'icon', name: 'box' %}</span>
      <button class="pcard__cmp" type="button" data-compare="{{ product.handle }}" aria-label="So sánh">{% render 'icon', name: 'compare' %}So sánh</button>
    </div>
  </article>
{%- else -%}
  <article class="pcard">
    <div class="pcard__img">{% render 'icon', name: 'box' %}</div>
    <span class="pcard__tag">-30%</span>
    <h3 class="pcard__title">Sản phẩm mẫu (thêm sản phẩm vào collection)</h3>
    <div class="pcard__price"><div class="price">1.990.000₫<s>2.890.000₫</s></div><span class="addcart">{% render 'icon', name: 'cart' %}</span></div>
  </article>
{%- endif -%}
