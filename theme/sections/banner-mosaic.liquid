{%- comment -%} Dùng cho: Xu hướng nổi bật, Hàng mới về, Better Health. Block đầu tiên là banner lớn. {%- endcomment -%}
<section class="container sec">
  <div class="sec__head">
    <h2 class="sec__title">{{ section.settings.title }}</h2>
    {%- if section.settings.more_link != blank -%}<a class="sec__more" href="{{ section.settings.more_link }}">Xem thêm ›</a>{%- endif -%}
  </div>
  <div class="mosaic{% if section.settings.big_left %} mosaic--left-big{% endif %}">
    {%- for block in section.blocks limit: 5 -%}
      <a href="{{ block.settings.link }}" class="{% if forloop.first %}is-big{% endif %}" {{ block.shopify_attributes }}>
        {% render 'placeholder', image: block.settings.image, title: block.settings.title, sub: block.settings.sub, bg: block.settings.bg, width: 1000 %}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Banner ghép (1 lớn + 4 nhỏ)",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Xu hướng nổi bật" },
    { "type": "url", "id": "more_link", "label": "Link xem thêm" },
    { "type": "checkbox", "id": "big_left", "label": "Banner lớn nằm bên trái", "default": false }
  ],
  "blocks": [
    { "type": "banner", "name": "Banner", "settings": [
      { "type": "image_picker", "id": "image", "label": "Ảnh" },
      { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Banner" },
      { "type": "text", "id": "sub", "label": "Mô tả" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "color", "id": "bg", "label": "Màu nền khi chưa có ảnh", "default": "#0066b3" }
    ]}
  ],
  "max_blocks": 5,
  "presets": [
    { "name": "Xu hướng (lũ lụt)", "blocks": [
      { "type": "banner", "settings": { "title": "Mùa mưa bão", "sub": "Tất cả sản phẩm cần thiết", "bg": "#0b2e59" } },
      { "type": "banner", "settings": { "title": "Chuẩn bị nhà cửa mùa mưa bão", "bg": "#2b8ad8" } },
      { "type": "banner", "settings": { "title": "Thiết bị cần thiết mùa lũ", "bg": "#0066b3" } },
      { "type": "banner", "settings": { "title": "Dọn dẹp nhà sau mưa lũ", "bg": "#1a9e5c" } },
      { "type": "banner", "settings": { "title": "Sửa sang nhà sau mưa lũ", "bg": "#f7931e" } } ] },
    { "name": "Hàng mới về", "settings": { "title": "Hàng mới về", "big_left": true }, "blocks": [
      { "type": "banner", "settings": { "title": "NEW ARRIVAL", "sub": "Bộ sưu tập mới nhất", "bg": "#0b2e59" } },
      { "type": "banner", "settings": { "title": "Pre Sale", "bg": "#e6007e" } },
      { "type": "banner", "settings": { "title": "Get it now", "bg": "#0066b3" } },
      { "type": "banner", "settings": { "title": "Halloween", "bg": "#f7931e" } },
      { "type": "banner", "settings": { "title": "Đèn LED 99K", "bg": "#2b8ad8" } } ] },
    { "name": "Sống khỏe mỗi ngày", "settings": { "title": "Sống khỏe mỗi ngày", "big_left": true }, "blocks": [
      { "type": "banner", "settings": { "title": "Sống khỏe, sống vui", "bg": "#1a9e5c" } },
      { "type": "banner", "settings": { "title": "Giấc ngủ", "bg": "#6b4fbb" } },
      { "type": "banner", "settings": { "title": "Không khí sạch", "bg": "#2b8ad8" } },
      { "type": "banner", "settings": { "title": "Khỏe mạnh", "bg": "#f7931e" } },
      { "type": "banner", "settings": { "title": "Tăng cường thể lực", "bg": "#e4002b" } } ] }
  ]
}
{% endschema %}
