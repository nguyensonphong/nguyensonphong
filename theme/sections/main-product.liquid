{%- comment -%}
  Trang chi tiết: cột trái là ảnh + tab nội dung, cột phải là khung mua.
  Metafield dùng (namespace custom, đều tuỳ chọn):
    sold (text, "1.2k+"), extra_offer (text), specs (nhiều dòng "Tên: Giá trị"), highlights (nhiều dòng)
  Tag dùng: free-install, free-shipping, best-price
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
{%- comment -%} Dịch vụ cộng thêm: chọn riêng từng sản phẩm qua metafield custom.addon_product; không có thì dùng mặc định của template (nếu đặt) {%- endcomment -%}
{%- assign addon = product.metafields.custom.addon_product.value | default: section.settings.addon_product -%}
<nav class="container crumbs" aria-label="Breadcrumb">
  <a href="{{ routes.root_url }}">Trang chủ</a> ›
  {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a> ›{%- elsif product.collections.size > 0 -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> ›{%- endif -%}
  <span>{{ product.title }}</span>
</nav>

<section class="container pdp">
  <div class="pdp__main">
    <div class="pdp__gallery" data-gallery>
      <div class="pdp__stage">
        {%- if v.compare_at_price > v.price -%}<span class="pdp__badge">FLASH ⚡ SALE</span>{%- endif -%}
        <button class="pdp__fav" type="button" aria-label="Yêu thích" data-fav>{% render 'icon', name: 'heart' %}</button>
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 1200 | image_tag: loading: 'eager', data-stage: '' }}
        {%- else -%}<div class="pcard__img">{% render 'icon', name: 'box' %}</div>{%- endif -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="pdp__thumbs">
          {%- for m in product.media limit: 8 -%}
            <button type="button" data-thumb="{{ m | image_url: width: 1200 }}" aria-label="Ảnh {{ forloop.index }}">{{ m | image_url: width: 120 | image_tag }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="pdp__share">
        <span>Chia sẻ</span>
        <a href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">f</a>
        <a href="https://zalo.me/share?url={{ shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener" aria-label="Zalo">Z</a>
        <button type="button" aria-label="Sao chép link" data-copy-link="{{ shop.url | append: product.url }}">🔗</button>
      </div>
    </div>

    {%- assign bundle = section.settings.bundle_collection -%}
    {%- if bundle and bundle.products_count > 0 -%}
      <div class="pdp__box">
        <h2 class="pdp__h">Sản phẩm mua kèm</h2>
        <div class="row-scroll">
          {%- for p in bundle.products limit: 8 -%}{%- unless p.id == product.id -%}{% render 'product-card', product: p %}{%- endunless -%}{%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    <div class="pdp__box" data-tabs>
      <div class="tabs" role="tablist">
        <button class="tab is-active" type="button" data-tab="1">Thông tin sản phẩm</button>
        <button class="tab" type="button" data-tab="2">Thông số kỹ thuật</button>
        {%- if product.tags contains 'free-install' -%}<button class="tab" type="button" data-tab="3">Điều kiện lắp đặt</button>{%- endif -%}
      </div>
      <div class="rte" data-panel="1"><h2 class="pdp__ptitle">{{ product.title }}</h2>{{ product.description | default: '<p>Chưa có mô tả.</p>' }}</div>
      <div data-panel="2" hidden>
        {%- assign specs = product.metafields.custom.specs.value | default: product.metafields.custom.specs -%}
        {%- if specs != blank -%}
          <table class="specs">
            <tr><th>SKU</th><td>{{ v.sku | default: '—' }}</td></tr>
            <tr><th>Thương hiệu</th><td>{{ product.vendor }}</td></tr>
            {%- assign lines = specs | newline_to_br | split: '<br />' -%}
            {%- for line in lines -%}
              {%- assign kv = line | strip | split: ':' -%}
              {%- if kv.size > 1 -%}<tr><th>{{ kv[0] | strip }}</th><td>{{ line | strip | remove_first: kv[0] | remove_first: ':' | strip }}</td></tr>{%- endif -%}
            {%- endfor -%}
          </table>
        {%- else -%}
          <table class="specs"><tr><th>SKU</th><td>{{ v.sku | default: '—' }}</td></tr><tr><th>Thương hiệu</th><td>{{ product.vendor }}</td></tr><tr><th>Loại</th><td>{{ product.type }}</td></tr></table>
        {%- endif -%}
      </div>
      <div class="rte" data-panel="3" hidden>{{ section.settings.install_terms }}</div>
    </div>
  </div>

  <aside class="buybox">
    {%- if v.compare_at_price > v.price -%}
      <div class="buybox__flash"><b>{{ shop.name }}</b><span>FLASH ⚡ SALE</span><em>Kết thúc trong <i data-countdown>23:59:59</i></em></div>
    {%- endif -%}
    <div class="buybox__head">
      <a class="pcard__vendor" href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
      <h1 class="buybox__title">{{ product.title }}</h1>
      <div class="buybox__meta">
        {%- assign pid = product.id | append: '' -%}<span>SKU: {{ v.sku | default: pid }}</span>
        <span>Bán bởi: <b>{{ shop.name }}</b></span>
        {%- if product.metafields.reviews.rating.value -%}<span class="stars">★★★★★ <small>{{ product.metafields.reviews.rating.value.rating }} ({{ product.metafields.reviews.rating_count | default: 0 }})</small></span>{%- endif -%}
      </div>
      <button class="link-btn buybox__cmp" type="button" data-compare="{{ product.handle }}">{% render 'icon', name: 'compare' %}So sánh</button>
    </div>
    <div class="chips">
      {%- if product.tags contains 'free-install' -%}<span class="chip">Lắp đặt miễn phí</span>{%- endif -%}
      {%- if product.tags contains 'free-shipping' -%}<span class="chip">Freeship</span>{%- endif -%}
      {%- if product.tags contains 'best-price' -%}<span class="chip chip--hot">Best Price</span>{%- endif -%}
    </div>

    {%- if product.metafields.custom.sold != blank -%}<div class="buybox__sold">Đã bán trong tháng <b>{{ product.metafields.custom.sold }}</b></div>{%- endif -%}
    <div class="buybox__price">
      <span class="price" data-price>{{ v.price | money_without_trailing_zeros }}</span>
      {%- if v.compare_at_price > v.price -%}
        {%- assign save = v.compare_at_price | minus: v.price -%}
        {%- assign pct = save | times: 100 | divided_by: v.compare_at_price | round -%}
        <s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>
        <div class="buybox__save">Bạn tiết kiệm {{ save | money_without_trailing_zeros }} (-{{ pct }}%)</div>
      {%- endif -%}
      {%- if product.metafields.custom.final_price != blank -%}<div class="buybox__final">Giá cuối* <b>{{ product.metafields.custom.final_price | money_without_trailing_zeros }}</b> /Cái</div>{%- endif -%}
      {%- if v.price >= 300000000 -%}<div class="buybox__inst">Trả góp 0% chỉ từ <b>{{ v.price | divided_by: 10 | money_without_trailing_zeros }}</b>/tháng (10 tháng)</div>{%- endif -%}
      {%- if product.metafields.custom.extra_offer != blank -%}<div class="pcard__extra">{{ product.metafields.custom.extra_offer }}</div>{%- endif -%}
    </div>

    {%- if product.tags contains 'trade-in' -%}
      <a class="tradein" href="{{ section.settings.tradein_link }}">
        {% render 'icon', name: 'recycle' %}
        <span><b>Thu cũ đổi mới</b> {{ section.settings.tradein_text }}</span><em>Xem ›</em>
      </a>
    {%- endif -%}

    {%- assign hl = product.metafields.custom.highlights.value | default: product.metafields.custom.highlights -%}
    {%- if hl != blank -%}<ul class="buybox__hl">{%- assign hls = hl | newline_to_br | split: '<br />' -%}{%- for h in hls -%}{%- if h != blank -%}<li>{{ h | strip }}</li>{%- endif -%}{%- endfor -%}</ul>{%- endif -%}

    <form method="post" action="{{ routes.cart_add_url }}" data-add-form>
      {%- unless product.has_only_default_variant -%}
        <div class="buybox__label">{{ product.options.first | upcase }}</div>
        <div class="vchips">
          {%- for variant in product.variants -%}
            <label class="vchip"><input type="radio" name="items[0][id]" value="{{ variant.id }}" {% if variant == v %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
              <span>{%- if variant.image -%}{{ variant.image | image_url: width: 120 | image_tag }}{%- endif -%}<em>{{ variant.title }}</em></span></label>
          {%- endfor -%}
        </div>
      {%- else -%}<input type="hidden" name="items[0][id]" value="{{ v.id }}">{%- endunless -%}

      {%- if product.tags contains 'free-install' or addon -%}
        <div class="buybox__services">
          <div class="buybox__label">Dịch vụ đi kèm</div>
          {%- if product.tags contains 'free-install' -%}<div class="svc">{% render 'icon', name: 'tools' %}<span>Lắp đặt miễn phí theo tiêu chuẩn cửa hàng</span><b>0₫</b></div>{%- endif -%}
          {%- if addon and addon.available -%}
            <label class="svc svc--opt"><input type="checkbox" name="items[1][id]" value="{{ addon.selected_or_first_available_variant.id }}"><span>{{ addon.title }}</span><b>+{{ addon.price | money_without_trailing_zeros }}</b></label>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="buybox__qty">
        <label class="buybox__label" for="qty-{{ section.id }}">Số lượng</label>
        <div class="qty"><button type="button" data-qstep="-1" aria-label="Giảm">−</button><input id="qty-{{ section.id }}" type="number" name="items[0][quantity]" value="1" min="1"><button type="button" data-qstep="1" aria-label="Tăng">+</button></div>
        <small>{%- if v.available -%}Còn hàng{%- if v.inventory_management == 'shopify' and v.inventory_quantity > 0 %} <b>{{ v.inventory_quantity }}</b> Cái{%- endif -%}{%- else -%}Hết hàng{%- endif -%}</small>
      </div>
      <div class="buybox__actions">
        <button class="btn btn--lg buybox__add" type="submit" {% unless v.available %}disabled{% endunless %}>{% if v.available %}THÊM VÀO GIỎ{% else %}HẾT HÀNG{% endif %}</button>
        {%- if section.settings.installment_link != blank -%}<a class="btn btn--outline btn--lg" href="{{ section.settings.installment_link }}">Trả góp 0%</a>{%- endif -%}
      </div>
    </form>

    <div class="buybox__ship">
      <div class="buybox__label">Hình thức giao hàng</div>
      <ul>
        <li>{% render 'icon', name: 'bolt' %}<span><b>Giao ngay</b> trong ngày (07:30–20:00)</span></li>
        <li>{% render 'icon', name: 'truck' %}<span><b>Giao ngày mai</b> khi đặt trước 20:30</span></li>
        <li>{% render 'icon', name: 'box' %}<span><b>Giao tiêu chuẩn</b> 2–5 ngày</span></li>
        <li>{% render 'icon', name: 'store' %}<span><b>Nhận tại cửa hàng</b> sau 1 giờ</span></li>
      </ul>
    </div>
  </aside>
</section>

{% schema %}
{
  "name": "Chi tiết sản phẩm",
  "settings": [
    { "type": "product", "id": "addon_product", "label": "Dịch vụ cộng thêm mặc định (tuỳ chọn)", "info": "Nên để trống và chọn riêng ở từng sản phẩm (trường 'Dịch vụ cộng thêm'). Chỉ dùng khi sản phẩm chưa chọn." },
    { "type": "collection", "id": "bundle_collection", "label": "Sản phẩm mua kèm" },
    { "type": "url", "id": "installment_link", "label": "Link trang trả góp" },
    { "type": "text", "id": "tradein_text", "label": "Thu cũ đổi mới: mô tả", "default": "trợ giá đến 1.000.000₫ khi đổi máy cũ", "info": "Hiện với sản phẩm có tag trade-in" },
    { "type": "url", "id": "tradein_link", "label": "Thu cũ đổi mới: link" },
    { "type": "richtext", "id": "install_terms", "label": "Điều kiện lắp đặt", "default": "<p>Lắp đặt miễn phí trong bán kính 40 km tính từ cửa hàng gần nhất. Phí phát sinh (ống đồng dài thêm, giá đỡ, đục tường) được báo giá trước khi thi công. Bảo hành lắp đặt 12 tháng.</p>" }
  ]
}
{% endschema %}
