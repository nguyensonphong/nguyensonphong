<section class="container sec">
  <div class="member">
    <div>
      {%- if customer -%}<span>Xin chào</span><b>{{ customer.first_name }}</b>
      {%- else -%}<span>Xin chào</span><span><a href="{{ routes.account_login_url }}">Đăng nhập</a> | <a href="{{ routes.account_register_url }}">Đăng ký</a></span>{%- endif -%}
    </div>
    <div><span>Mã giảm giá của bạn</span><b data-coupon-count>0 mã</b></div>
    <div><span>Thẻ thành viên</span><a href="{{ section.settings.card_link }}">Liên kết / đăng ký thẻ thành viên</a></div>
    <div><span>Ví của bạn</span><b>{{ customer.metafields.custom.wallet | default: 0 }}₫</b></div>
  </div>

  <div class="sec__head" style="margin-top:20px">
    <h2 class="sec__title" style="font-size:20px">{{ section.settings.title }}</h2>
    <a class="sec__more" href="{{ section.settings.more_link }}">Xem thêm ›</a>
  </div>
  <div class="coupons">
    {%- for block in section.blocks -%}
      <div class="coupon" {{ block.shopify_attributes }}>
        <div class="coupon__val">{{ block.settings.value }}<small>Giảm</small></div>
        <div class="coupon__body">
          <p>{{ block.settings.text }}</p>
          <div class="coupon__act">
            <a href="{{ block.settings.terms }}">Điều kiện</a>
            <button class="btn btn--sm" type="button" data-coupon="{{ block.settings.code | escape }}">Lưu</button>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Thành viên & Coupon",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Còn nhiều mã giảm giá đang chờ bạn" },
    { "type": "url", "id": "more_link", "label": "Link xem thêm" },
    { "type": "url", "id": "card_link", "label": "Link Home Card" }
  ],
  "blocks": [
    { "type": "coupon", "name": "Coupon", "settings": [
      { "type": "text", "id": "value", "label": "Giá trị", "default": "10%" },
      { "type": "text", "id": "text", "label": "Điều kiện", "default": "cho đơn từ 1 triệu" },
      { "type": "text", "id": "code", "label": "Mã giảm giá Shopify", "info": "Khi bấm Lưu, mã được lưu và tự áp dụng lúc thanh toán." },
      { "type": "url", "id": "terms", "label": "Link điều kiện" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Thành viên & Coupon", "blocks": [
    { "type": "coupon", "settings": { "value": "10%", "text": "Giảm 10% cho đơn từ 1 triệu" } },
    { "type": "coupon", "settings": { "value": "5%", "text": "Giảm 5% cho đơn từ 3 triệu" } },
    { "type": "coupon", "settings": { "value": "1TR", "text": "Giảm 1 triệu cho đơn từ 100 triệu" } },
    { "type": "coupon", "settings": { "value": "100K", "text": "Giảm 100K cho đơn từ 500K" } }
  ]}]
}
{% endschema %}
