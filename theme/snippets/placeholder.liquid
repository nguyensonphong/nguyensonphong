{%- comment -%} Ảnh banner: dùng image nếu có, nếu không thì khối màu có chữ. Tham số: image, title, sub, eyebrow, bg, color, width {%- endcomment -%}
{%- assign w = width | default: 1200 -%}
{%- if image -%}
  {{ image | image_url: width: w | image_tag: loading: 'lazy', alt: title, style: 'width:100%;height:100%;object-fit:cover' }}
{%- else -%}
  <div class="ph" style="background:{{ bg | default: '#0066b3' }};color:{{ color | default: '#fff' }}">
    {%- if eyebrow != blank -%}<small>{{ eyebrow }}</small>{%- endif -%}
    <strong>{{ title }}</strong>
    {%- if sub != blank -%}<span>{{ sub }}</span>{%- endif -%}
  </div>
{%- endif -%}
