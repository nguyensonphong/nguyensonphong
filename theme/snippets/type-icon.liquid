  {%- elsif k contains 'tai nghe' -%}<path d="M12 40v-8a20 20 0 0140 0v8"/><rect x="8" y="38" width="10" height="16" rx="3"/><rect x="46" y="38" width="10" height="16" rx="3"/>
  {%- elsif k contains 'loa' -%}<rect x="16" y="6" width="32" height="52" rx="4"/><circle cx="32" cy="40" r="9"/><circle cx="32" cy="18" r="4"/>
  {%- elsif k contains 'nước nóng' -%}<rect x="18" y="4" width="28" height="44" rx="10"/><path d="M26 48v8M38 48v8"/><circle cx="32" cy="18" r="4"/>
  {%- elsif k contains 'lọc nước' or k contains 'cây nước' -%}<rect x="18" y="16" width="28" height="42" rx="3"/><path d="M24 4h16v12H24zM26 30h4M34 30h4"/>
  {%- elsif k contains 'bồn cầu' or k contains 'nắp rửa' -%}<path d="M16 6h20v18H16z"/><path d="M10 28h40a20 14 0 01-40 0z"/><path d="M22 42l-2 14h16l-2-14"/>
  {%- elsif k contains 'lavabo' or k contains 'chậu' -%}<path d="M6 26h52a26 18 0 01-52 0z"/><path d="M32 6v12M26 10h12"/>
  {%- elsif k contains 'vòi' or k contains 'sen' -%}<path d="M14 56V20a10 10 0 0110-10h16a10 10 0 0110 10v6"/><path d="M42 26h16M46 34v4M54 34v4M50 34v6"/>
  {%- elsif k contains 'bàn ủi' or k contains 'bàn là' -%}<path d="M8 44h46a4 4 0 004-4c0-10-10-20-24-20H22"/><path d="M8 44c0-10 6-18 14-20M30 20v-8h14"/>
  {%- elsif k contains 'điện thoại' -%}<rect x="18" y="4" width="28" height="56" rx="4"/><path d="M28 52h8"/>
  {%- elsif k contains 'hộp' or k contains 'bình giữ' -%}<rect x="10" y="22" width="44" height="30" rx="4"/><path d="M8 16h48v6H8z"/>
  {%- endif -%}
{%- endcapture -%}
{%- if d != blank -%}
  <svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ d }}</svg>
{%- elsif fallback.featured_image -%}
  {{ fallback.featured_image | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
{%- endif -%}
