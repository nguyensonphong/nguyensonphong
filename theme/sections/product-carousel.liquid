{%- assign col = section.settings.collection -%}
<section class="block container{% if section.settings.flash %} block--flash{% endif %}">
  <div class="block__head">
    <h2 class="block__title">
      {%- if section.settings.flash -%}<span class="flash-badge">⚡ FLASH SALE</span>{%- endif -%}
      {{ section.settings.title }}
    </h2>
    {%- if section.settings.flash and section.settings.ends_at != blank -%}
      <div class="countdown" data-countdown="{{ section.settings.ends_at }}">
        <span>จบใน</span><b data-h>00</b>:<b data-m>00</b>:<b data-s>00</b>
      </div>
    {%- endif -%}
    {%- if col -%}<a class="block__more" href="{{ col.url }}">ดูทั้งหมด ›</a>{%- endif -%}
  </div>
  <div class="row-scroll">
    {%- if col and col.products_count > 0 -%}
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..6) -%}{% render 'product-card' %}{%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Dải sản phẩm",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "สินค้าขายดี" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Số sản phẩm", "min": 4, "max": 24, "step": 1, "default": 12 },
    { "type": "checkbox", "id": "flash", "label": "Kiểu Flash Sale", "default": false },
    { "type": "text", "id": "ends_at", "label": "Kết thúc lúc (YYYY-MM-DDTHH:MM, giờ Bangkok)", "info": "Ví dụ 2026-10-10T23:59" }
  ],
  "presets": [{ "name": "Dải sản phẩm" }]
}
{% endschema %}
