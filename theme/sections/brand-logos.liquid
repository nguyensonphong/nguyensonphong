<section class="container sec">
  <div class="sec__head">
    <h2 class="sec__title">{{ section.settings.title }}</h2>
    {%- if section.settings.more_link != blank -%}<a class="sec__more" href="{{ section.settings.more_link }}">ดูทั้งหมด ›</a>{%- endif -%}
  </div>
  <div class="row-scroll logos">
    {%- for block in section.blocks -%}
      <a class="logo-box" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        {%- if block.settings.logo -%}{{ block.settings.logo | image_url: height: 96 | image_tag: alt: block.settings.name, style: 'max-height:48px;width:auto' }}{%- else -%}{{ block.settings.name }}{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Thương hiệu nổi bật",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "แบรนด์ยอดนิยม" },
    { "type": "url", "id": "more_link", "label": "Link xem tất cả" }
  ],
  "blocks": [
    { "type": "brand", "name": "Thương hiệu", "settings": [
      { "type": "text", "id": "name", "label": "Tên", "default": "Brand" },
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "url", "id": "link", "label": "Link", "info": "Gợi ý: /collections/vendors?q=Tên hãng" }
    ]}
  ],
  "max_blocks": 30,
  "presets": [{ "name": "Thương hiệu nổi bật", "blocks": [
    { "type": "brand", "settings": { "name": "LG" } }, { "type": "brand", "settings": { "name": "Samsung" } },
    { "type": "brand", "settings": { "name": "Electrolux" } }, { "type": "brand", "settings": { "name": "Mitsubishi Electric" } },
    { "type": "brand", "settings": { "name": "Haier" } }, { "type": "brand", "settings": { "name": "Cabin" } },
    { "type": "brand", "settings": { "name": "Bosch" } }, { "type": "brand", "settings": { "name": "TOTO" } },
    { "type": "brand", "settings": { "name": "COTTO" } }
  ]}]
}
{% endschema %}
