<section class="container" style="max-width:420px;padding-block:40px"><h1 class="page-title">เข้าสู่ระบบ</h1>
{%- form 'customer_login' -%}{{ form.errors | default_errors }}
<input type="email" name="customer[email]" placeholder="อีเมล" required style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<input type="password" name="customer[password]" placeholder="รหัสผ่าน" required style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<button class="btn" type="submit" style="width:100%">เข้าสู่ระบบ</button>{%- endform -%}
<p class="center"><a href="{{ routes.account_register_url }}" style="color:var(--hp-blue)">ลงทะเบียน</a></p></section>
