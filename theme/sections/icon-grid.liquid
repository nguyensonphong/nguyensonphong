<section class="container sec">
  {%- if section.settings.title != blank -%}<div class="sec__head"><h2 class="sec__title">{{ section.settings.title }}</h2></div>{%- endif -%}
  <div class="icons">
    {%- for block in section.blocks -%}
      <a class="ic" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        <span style="background:{{ block.settings.color }}">
          {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 128 | image_tag: style: 'width:100%;height:100%;object-fit:cover;border-radius:50%' }}
          {%- else -%}{% render 'icon', name: block.settings.icon %}{%- endif -%}
        </span>
        {{ block.settings.label }}
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lưới icon tiện ích",
  "settings": [{ "type": "text", "id": "title", "label": "Tiêu đề (tuỳ chọn)" }],
  "blocks": [
    { "type": "item", "name": "Icon", "settings": [
      { "type": "text", "id": "label", "label": "Nhãn", "default": "Mã giảm giá" },
      { "type": "url", "id": "link", "label": "Link" },
      { "type": "image_picker", "id": "image", "label": "Ảnh icon (tuỳ chọn)" },
      { "type": "text", "id": "icon", "label": "Tên icon mặc định", "default": "coupon" },
      { "type": "color", "id": "color", "label": "Màu nền", "default": "#0066b3" }
    ]}
  ],
  "max_blocks": 15,
  "presets": [{ "name": "Lưới icon tiện ích", "blocks": [
    { "type": "item", "settings": { "label": "Xả kho", "icon": "tag", "color": "#e4002b" } },
    { "type": "item", "settings": { "label": "Mã giảm giá", "icon": "coupon", "color": "#f7931e" } },
    { "type": "item", "settings": { "label": "Mall", "icon": "store", "color": "#0066b3" } },
    { "type": "item", "settings": { "label": "Thu cũ đổi mới", "icon": "recycle", "color": "#1a9e5c" } },
    { "type": "item", "settings": { "label": "Thẻ thành viên", "icon": "card", "color": "#0b2e59" } },
    { "type": "item", "settings": { "label": "Lắp đặt miễn phí", "icon": "tools", "color": "#2b8ad8" } },
    { "type": "item", "settings": { "label": "Tổng hợp ưu đãi", "icon": "gift", "color": "#e6007e" } },
    { "type": "item", "settings": { "label": "Trung tâm sửa chữa", "icon": "wrench", "color": "#6b4fbb" } },
    { "type": "item", "settings": { "label": "Circular Economy", "icon": "leaf", "color": "#3aa335" } },
    { "type": "item", "settings": { "label": "Kiếm thu nhập cùng chúng tôi", "icon": "home", "color": "#f7931e" } }
  ]}]
}
{% endschema %}
