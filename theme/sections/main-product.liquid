{%- assign v = product.selected_or_first_available_variant -%}
<section class="container product">
  <div class="product__media">
    {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 1000 | image_tag: loading: 'eager' }}{%- else -%}<div class="pcard__img">{% render 'icon', name: 'box' %}</div>{%- endif -%}
  </div>
  <div>
    <div class="pcard__vendor">{{ product.vendor }}</div>
    <h1>{{ product.title }}</h1>
    <div class="price" style="font-size:28px">{{ v.price | money_without_trailing_zeros }}
      {%- if v.compare_at_price > v.price -%}<s>{{ v.compare_at_price | money_without_trailing_zeros }}</s>{%- endif -%}
    </div>
    {%- form 'product', product, data-add-form: '' -%}
      {%- unless product.has_only_default_variant -%}
        <select name="id" style="width:100%;padding:10px;margin:16px 0;border:1px solid var(--hp-line);border-radius:8px">
          {%- for variant in product.variants -%}<option value="{{ variant.id }}" {% if variant == v %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title }} — {{ variant.price | money_without_trailing_zeros }}</option>{%- endfor -%}
        </select>
      {%- else -%}<input type="hidden" name="id" value="{{ v.id }}">{%- endunless -%}
      <div style="display:flex;gap:10px;margin:16px 0">
        <input type="number" name="quantity" value="1" min="1" aria-label="Số lượng" style="width:80px;padding:10px;border:1px solid var(--hp-line);border-radius:8px">
        <button class="btn" type="submit" {% unless v.available %}disabled{% endunless %} style="flex:1">{% if v.available %}Thêm vào giỏ{% else %}Hết hàng{% endif %}</button>
      </div>
    {%- endform -%}
    <div class="chips" style="margin-bottom:16px"><span class="chip">Trả góp 0% 10 tháng</span><span class="chip">Nhận tại cửa hàng</span><span class="chip">Miễn phí giao hàng cho đơn từ 1 triệu</span></div>
    <div>{{ product.description }}</div>
  </div>
</section>
{% schema %}{ "name": "Chi tiết sản phẩm" }{% endschema %}
