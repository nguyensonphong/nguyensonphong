<section class="container auth"><div class="auth__card">
  <h1 class="page-title">Đặt mật khẩu mới</h1>
  {%- form 'reset_customer_password', class: 'auth__form' -%}
    {%- if form.errors -%}<p class="contact__err">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label for="p-pass">Mật khẩu mới</label><input class="field" id="p-pass" type="password" name="customer[password]" autocomplete="new-password" required>
    <label for="p-pass2">Nhập lại mật khẩu</label><input class="field" id="p-pass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn btn--lg" type="submit">Lưu mật khẩu</button>
  {%- endform -%}
</div></section>
