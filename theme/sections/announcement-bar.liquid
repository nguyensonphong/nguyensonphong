<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__msg">{{ section.settings.text }}</p>
    <nav class="topbar__links">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endfor -%}
    </nav>
  </div>
</div>

{% schema %}
{
  "name": "Thanh thông báo",
  "settings": [
    { "type": "text", "id": "text", "label": "Nội dung", "default": "ส่งฟรี เมื่อช้อปครบ 1,000.- | ผ่อน 0% นาน 10 เดือน" }
  ],
  "blocks": [
    { "type": "link", "name": "Liên kết", "settings": [
      { "type": "text", "id": "label", "label": "Nhãn", "default": "ค้นหาสาขา" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "presets": [{ "name": "Thanh thông báo" }]
}
{% endschema %}
