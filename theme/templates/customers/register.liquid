<section class="container" style="max-width:420px;padding-block:40px"><h1 class="page-title">Đăng ký</h1>
{%- form 'create_customer' -%}{{ form.errors | default_errors }}
<input name="customer[first_name]" placeholder="Tên" style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<input type="email" name="customer[email]" placeholder="Email" required style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<input type="password" name="customer[password]" placeholder="Mật khẩu" required style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<button class="btn" type="submit" style="width:100%">Tạo tài khoản</button>{%- endform -%}</section>
