<section class="container" style="max-width:420px;padding-block:40px"><h1 class="page-title">ลงทะเบียน</h1>
{%- form 'create_customer' -%}{{ form.errors | default_errors }}
<input name="customer[first_name]" placeholder="ชื่อ" style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<input type="email" name="customer[email]" placeholder="อีเมล" required style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<input type="password" name="customer[password]" placeholder="รหัสผ่าน" required style="width:100%;padding:10px;margin-bottom:10px;border:1px solid var(--hp-line);border-radius:8px">
<button class="btn" type="submit" style="width:100%">สมัครสมาชิก</button>{%- endform -%}</section>
