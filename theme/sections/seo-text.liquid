<section class="container sec">
  <div class="seo">
    <h2>{{ section.settings.title }}</h2>
    <div class="clamp" data-clamp>{{ section.settings.text }}</div>
    <button type="button" data-clamp-toggle>Đọc tiếp</button>
  </div>
</section>

{% schema %}
{
  "name": "Đoạn giới thiệu SEO",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "Mọi thứ cho ngôi nhà, cả sản phẩm và dịch vụ" },
    { "type": "richtext", "id": "text", "label": "Nội dung", "default": "<p>Trung tâm mua sắm mọi thứ cho ngôi nhà: điện máy, nội thất, đồ trang trí, vật liệu xây dựng và dụng cụ, kèm dịch vụ lắp đặt, bảo trì và giao hàng tận nhà. Mua online 24/7 hoặc nhận hàng tại cửa hàng gần bạn.</p>" }
  ],
  "presets": [{ "name": "Đoạn giới thiệu SEO" }]
}
{% endschema %}
