<nav class="container crumbs"><a href="{{ routes.root_url }}">Trang chủ</a> › <span>{{ blog.title }}</span></nav>
<section class="container">
  <h1 class="page-title">{{ blog.title }}</h1>
  {%- if blog.all_tags.size > 0 -%}
    <div class="tabs"><a class="tab{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">Tất cả</a>
      {%- for t in blog.all_tags -%}<a class="tab{% if current_tags contains t %} is-active{% endif %}" href="{{ blog.url }}/tagged/{{ t | handle }}">{{ t }}</a>{%- endfor -%}</div>
  {%- endif -%}
  {%- paginate blog.articles by 12 -%}
  <div class="posts">
    {%- for article in blog.articles -%}
      <a class="post{% if forloop.first and paginate.current_page == 1 %} post--lead{% endif %}" href="{{ article.url }}">
        <div class="post__img">{%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{%- else -%}{% render 'placeholder', title: article.title, bg: '#0B6B09' %}{%- endif -%}</div>
        <div class="post__body">
          {%- if article.tags.size > 0 -%}<small>{{ article.tags.first }}</small>{%- endif -%}
          <h2>{{ article.title }}</h2>
          <p>{{ article.excerpt_or_content | strip_html | truncatewords: 28 }}</p>
          <span class="muted">{{ article.published_at | date: '%d/%m/%Y' }}</span>
        </div>
      </a>
    {%- else -%}<p>Chưa có bài viết.</p>{%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div class="center pager">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>
{% schema %}{ "name": "Blog" }{% endschema %}
