<section class="container sec">
  <div class="seo">
    <h2>{{ section.settings.title }}</h2>
    <div class="clamp" data-clamp>{{ section.settings.text }}</div>
    <button type="button" data-clamp-toggle>อ่านทั้งหมด</button>
  </div>
</section>

{% schema %}
{
  "name": "Đoạn giới thiệu SEO",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "ครบครันเรื่องบ้าน ทั้งสินค้าและบริการ" },
    { "type": "richtext", "id": "text", "label": "Nội dung", "default": "<p>ศูนย์รวมสินค้าเกี่ยวกับบ้านครบวงจร ทั้งเครื่องใช้ไฟฟ้า เฟอร์นิเจอร์ ของแต่งบ้าน วัสดุก่อสร้าง และเครื่องมือช่าง พร้อมบริการติดตั้ง ซ่อมบำรุง และจัดส่งถึงบ้าน ช้อปออนไลน์ได้ตลอด 24 ชั่วโมง หรือเลือกรับสินค้าที่สาขาใกล้บ้าน</p>" }
  ],
  "presets": [{ "name": "Đoạn giới thiệu SEO" }]
}
{% endschema %}
