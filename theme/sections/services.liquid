<section class="container sec">
  {%- if section.settings.show_card -%}
    <div class="homecard" style="margin-bottom:var(--sec)">
      <div><h3>{{ section.settings.card_title }}</h3><p style="margin:4px 0 0;opacity:.9">{{ section.settings.card_sub }}</p></div>
      <a class="btn btn--orange" href="{{ section.settings.card_link }}">สมัครเลย !</a>
    </div>
  {%- endif -%}
  <div class="services__intro">
    <h2 class="sec__title">{{ section.settings.title }}</h2>
    <p>{{ section.settings.intro }}</p>
  </div>
  <div class="services">
    {%- for block in section.blocks -%}
      <a class="service" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% render 'placeholder', image: block.settings.image, title: '', bg: block.settings.bg, width: 600 %}
        <span>{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
  <div class="center"><a class="btn btn--orange" href="{{ section.settings.more_link }}">ดูเพิ่มเติม</a></div>
</section>

{% schema %}
{
  "name": "Dịch vụ & Home Card",
  "settings": [
    { "type": "checkbox", "id": "show_card", "label": "Hiện banner Home Card", "default": true },
    { "type": "text", "id": "card_title", "label": "Tiêu đề Home Card", "default": "สิทธิพิเศษสำหรับสมาชิกโฮมการ์ด" },
    { "type": "text", "id": "card_sub", "label": "Mô tả", "default": "สะสมคะแนน แลกส่วนลด และรับโปรโมชั่นก่อนใคร" },
    { "type": "url", "id": "card_link", "label": "Link đăng ký" },
    { "type": "text", "id": "title", "label": "Tiêu đề dịch vụ", "default": "บริการเรื่องบ้าน" },
    { "type": "textarea", "id": "intro", "label": "Mô tả", "default": "ทีมช่างผู้เชี่ยวชาญพร้อมดูแลทุกเรื่องบ้าน ตั้งแต่สำรวจหน้างาน ติดตั้ง จนถึงบริการหลังการขาย" },
    { "type": "url", "id": "more_link", "label": "Link xem thêm" }
  ],
  "blocks": [
    { "type": "service", "name": "Dịch vụ", "settings": [
      { "type": "image_picker", "id": "image", "label": "Ảnh" },
      { "type": "text", "id": "title", "label": "Tên", "default": "บริการล้างแอร์" },
      { "type": "color", "id": "bg", "label": "Màu nền khi chưa có ảnh", "default": "#2b8ad8" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Dịch vụ & Home Card", "blocks": [
    { "type": "service", "settings": { "title": "บริการปรับปรุงห้องครัว", "bg": "#f7931e" } },
    { "type": "service", "settings": { "title": "บริการปรับปรุงห้องน้ำ", "bg": "#2b8ad8" } },
    { "type": "service", "settings": { "title": "บริการติดตั้งระบบน้ำ", "bg": "#0b2e59" } },
    { "type": "service", "settings": { "title": "บริการล้างแอร์", "bg": "#1a9e5c" } }
  ]}]
}
{% endschema %}
