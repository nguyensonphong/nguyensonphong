{%- comment -%} Ảnh banner: dùng image nếu có, nếu không thì khối màu có chữ. Tham số: image, src (link ảnh ngoài, vd Unsplash), title, sub, eyebrow, bg, color, width {%- endcomment -%}
{%- assign w = width | default: 1200 -%}
{%- if image -%}
  {{ image | image_url: width: w | image_tag: loading: 'lazy', alt: title, style: 'width:100%;height:100%;object-fit:cover' }}
{%- else -%}
  <div class="ph{% if src != blank %} ph--photo{% endif %}" style="background:{% if src != blank %}linear-gradient(90deg,rgba(0,0,0,.55),rgba(0,0,0,.05)),url('{{ src }}&w={{ w }}&q=75&auto=format&fit=crop') center/cover,{% endif %}{{ bg | default: '#0B6B09' }};color:{{ color | default: '#fff' }}">
    {%- if eyebrow != blank -%}<small>{{ eyebrow }}</small>{%- endif -%}
    <strong>{{ title }}</strong>
    {%- if sub != blank -%}<span>{{ sub }}</span>{%- endif -%}
  </div>
{%- endif -%}
