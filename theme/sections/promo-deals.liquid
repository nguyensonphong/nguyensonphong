<section class="container sec">
  <div class="sec__head"><h2 class="sec__title">{{ section.settings.title }}</h2></div>
  <div class="tabs">
    {%- for link in linklists[section.settings.tab_menu].links -%}
      <a class="tab{% if forloop.first %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>
  <div class="promos">
    {%- for block in section.blocks -%}
      <a class="promo" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {% render 'placeholder', image: block.settings.image, title: block.settings.title, sub: block.settings.sub, bg: 'transparent', width: 800 %}
      </a>
    {%- endfor -%}
  </div>
  <div class="center"><a class="btn btn--orange" href="{{ section.settings.more_link }}">ดูทั้งหมด</a></div>
</section>

{% schema %}
{
  "name": "Ưu đãi nổi bật",
  "settings": [
    { "type": "text", "id": "title", "label": "Tiêu đề", "default": "โปรเด็ด" },
    { "type": "link_list", "id": "tab_menu", "label": "Menu tab", "info": "โปรจัดหนัก, หมวดหมู่ทั้งหมด, เครื่องใช้ไฟฟ้าเล็ก, เฟอร์นิเจอร์…" },
    { "type": "url", "id": "more_link", "label": "Link xem tất cả" }
  ],
  "blocks": [
    { "type": "promo", "name": "Banner ưu đãi", "settings": [
      { "type": "image_picker", "id": "image", "label": "Ảnh" },
      { "type": "text", "id": "title", "label": "Tiêu đề", "default": "ซื้อ 1 แถม 1" },
      { "type": "text", "id": "sub", "label": "Mô tả" },
      { "type": "url", "id": "link", "label": "Link" }
    ]}
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Ưu đãi nổi bật", "blocks": [
    { "type": "promo", "settings": { "title": "ซื้อ 1 แถม 1" } },
    { "type": "promo", "settings": { "title": "ฟรี ของแถม" } },
    { "type": "promo", "settings": { "title": "ลด สูงสุด 80%" } }
  ]}]
}
{% endschema %}
