<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  {%- if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}">{% else %}<link rel="icon" type="image/svg+xml" href="{{ 'gkmall-icon.svg' | asset_url }}">{% endif %}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- case settings.font_family -%}
    {%- when 'roboto' -%}{%- assign gf = 'Roboto:wght@400;500;700' -%}{%- assign ff = '"Roboto",Arial,sans-serif' -%}
    {%- when 'be_vietnam' -%}{%- assign gf = 'Be+Vietnam+Pro:wght@400;500;600;700;800;900' -%}{%- assign ff = '"Be Vietnam Pro",Arial,sans-serif' -%}
    {%- when 'inter' -%}{%- assign gf = 'Inter:wght@400;500;600;700' -%}{%- assign ff = '"Inter",Arial,sans-serif' -%}
    {%- when 'system' -%}{%- assign gf = '' -%}{%- assign ff = 'Helvetica,Arial,sans-serif' -%}
    {%- else -%}{%- assign gf = 'Prompt:wght@400;500;600;700' -%}{%- assign ff = '"Prompt",Tahoma,sans-serif' -%}
  {%- endcase -%}
  {%- if gf != blank -%}<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family={{ gf }}&display=swap">{%- endif -%}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root{
      --hp-blue:{{ settings.color_primary }};
      --hp-blue-footer:{{ settings.color_footer }};
      --hp-orange:{{ settings.color_accent }};
      --hp-red:{{ settings.color_price }};
      --hp-sky:{{ settings.color_soft }};
      --font:{{ ff }};
    }
  </style>
  {{ content_for_header }}
</head>
<body>
  <a class="visually-hidden" href="#main">Chuyển đến nội dung</a>
  {% sections 'header-group' %}
  <main id="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {%- if settings.chat_url != blank -%}
    <a class="chatfab" href="{{ settings.chat_url }}"><i>🤖</i>Chat</a>
  {%- endif -%}
  <div class="toast" role="status" data-toast></div>
  <div class="cmpbar" data-cmpbar hidden><span>Đang so sánh <b data-cmp-count>0</b>/4 sản phẩm</span><button class="link-btn" type="button" data-cmp-clear>Xóa</button><a class="btn btn--orange btn--sm" href="/pages/compare">So sánh ngay</a></div>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
