{%- comment -%}
  Icon nét mảnh theo ngành hàng (kiểu HomePro). Dùng: render 'type-icon', type: 'Tủ lạnh', fallback: product
  Không có icon riêng → hiện ảnh sản phẩm đầu tiên.
{%- endcomment -%}
{%- assign k = type | downcase -%}
{%- capture d -%}
  {%- if k contains 'tivi' or k contains 'màn hình' -%}<rect x="6" y="12" width="52" height="32" rx="2"/><path d="M24 52h16M32 44v8"/>
  {%- elsif k contains 'tủ lạnh' or k contains 'tủ đông' -%}<rect x="16" y="6" width="32" height="52" rx="3"/><path d="M16 26h32M32 6v52M28 14v6M36 14v6M28 32v6M36 32v6"/>
  {%- elsif k contains 'máy giặt' or k contains 'máy sấy' -%}<rect x="12" y="6" width="40" height="52" rx="3"/><path d="M12 16h40"/><circle cx="32" cy="37" r="12"/><circle cx="32" cy="37" r="6"/><path d="M18 11h4M44 11h2"/>
  {%- elsif k contains 'điều hòa' -%}<rect x="4" y="16" width="56" height="20" rx="4"/><path d="M10 30h44M18 44l-2 6M32 44v6M46 44l2 6"/>
  {%- elsif k contains 'lọc không khí' or k contains 'hút ẩm' -%}<rect x="18" y="6" width="28" height="52" rx="6"/><path d="M24 16h16M24 22h16M24 28h16"/><circle cx="32" cy="44" r="6"/>
  {%- elsif k contains 'robot' -%}<circle cx="32" cy="34" r="22"/><circle cx="32" cy="34" r="8"/><path d="M20 22l4 4"/>
  {%- elsif k contains 'hút bụi' -%}<path d="M40 6l-8 38M22 44h20l4 8H18z"/><circle cx="40" cy="6" r="2"/><path d="M38 14h6"/>
  {%- elsif k contains 'lò vi sóng' or k contains 'lò nướng' -%}<rect x="6" y="14" width="52" height="34" rx="3"/><rect x="12" y="20" width="30" height="22" rx="2"/><path d="M50 22v2M50 30v2M50 38v2"/>
  {%- elsif k contains 'nồi cơm' -%}<path d="M12 28h40v18a10 10 0 01-10 10H22a10 10 0 01-10-10z"/><path d="M10 28a22 12 0 0144 0"/><path d="M28 18h8"/>
  {%- elsif k contains 'chiên' -%}<rect x="14" y="8" width="36" height="48" rx="10"/><rect x="20" y="30" width="24" height="18" rx="3"/><circle cx="32" cy="18" r="4"/>
  {%- elsif k contains 'xay' or k contains 'ép' or k contains 'vắt' -%}<path d="M20 8h24l-4 32H24z"/><rect x="18" y="40" width="28" height="16" rx="3"/><circle cx="32" cy="48" r="3"/>
  {%- elsif k contains 'ấm' or k contains 'bình đun' or k contains 'bình thủy' -%}<path d="M18 18h24l4 36H14z"/><path d="M42 24h6a4 4 0 014 4v8a4 4 0 01-4 4h-4"/><path d="M24 10h12v8H24z"/>
  {%- elsif k contains 'rửa bát' -%}<rect x="10" y="6" width="44" height="52" rx="3"/><path d="M10 16h44M16 11h6"/><path d="M18 26h28M18 34h28M18 42h28"/>
  {%- elsif k contains 'hút mùi' -%}<path d="M26 6h12v16H26zM8 34l18-12h12l18 12z"/><path d="M8 34h48v6H8z"/>
  {%- elsif k contains 'bếp' -%}<rect x="6" y="14" width="52" height="36" rx="3"/><circle cx="22" cy="32" r="8"/><circle cx="44" cy="32" r="6"/>
  {%- elsif k contains 'cà phê' -%}<rect x="14" y="6" width="36" height="12" rx="2"/><path d="M18 18v26h28V18M24 32h16v10H24zM14 52h36"/>
